// Fonte de verdade do schema: docs/02-modelo-dominio.md
// RawCapture fica fora deste schema por decisao da Fase 1 (so existe a partir da Fase 2 - WhatsApp).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDEDOR
  COMPRADOR
  GERENTE
}

// Ciclo simplificado (ADR-0008): a etapa de cotacao foi eliminada porque na
// pratica ela dura minutos. CONCLUIDA = pedido feito na distribuidora vencedora.
enum ShortageStatus {
  REGISTRADA
  CONCLUIDA
  RECEBIDA
  CANCELADA
}

enum EmprestimoStatus {
  PENDENTE
  DEVOLVIDA
}

enum TarefaStatus {
  A_FAZER
  EM_ANDAMENTO
  CONCLUIDA
}

enum ShortageOrigin {
  WEB
  WHATSAPP_AUDIO
  WHATSAPP_TEXTO
}

model Store {
  id              String   @id @default(uuid())
  codigo          String   @unique
  senhaHash       String?  @map("senha_hash")
  nome            String
  segmento        String   @default("AUTOPECAS")
  whatsappNumero  String?  @map("whatsapp_numero")
  ativa           Boolean  @default(true)
  criadaEm        DateTime @default(now()) @map("criada_em")
  atualizadaEm    DateTime @updatedAt @map("atualizada_em")

  users          User[]
  shortages      Shortage[]
  distribuidoras Distribuidora[]
  emprestimos    Emprestimo[]
  sprints        Sprint[]
  tarefas        Tarefa[]

  @@map("stores")
}

// ADMIN e COMPRADOR logam com email+senha (de qualquer lugar). VENDEDOR loga
// atraves da sessao da loja (Store.codigo+senhaHash) + escolha do proprio nome
// na lista + PIN curto (usuario+pinHash) - ver ADR-0007. Por isso email/senhaHash
// sao opcionais aqui (nulos para VENDEDOR) e usuario/pinHash tambem sao opcionais
// (nulos para ADMIN/COMPRADOR). A regra de qual conjunto e obrigatorio por papel
// vive no dominio (UserManagementUseCaseImpl), nao no schema.
model User {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  store             Store    @relation(fields: [storeId], references: [id])
  nome              String
  email             String?
  senhaHash         String?  @map("senha_hash")
  usuario           String?
  pinHash           String?  @map("pin_hash")
  telefoneWhatsapp  String?  @unique @map("telefone_whatsapp")
  papel             Role
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  shortagesRegistradas  Shortage[]         @relation("RegistradoPor")
  transicoesExecutadas  StatusTransition[] @relation("ExecutadaPor")
  emprestimosRegistrados Emprestimo[]      @relation("EmprestimoRegistradoPor")
  emprestimosDevolvidos  Emprestimo[]      @relation("EmprestimoDevolvidoPor")
  sprintsCriadas         Sprint[]          @relation("SprintCriadoPor")
  tarefasCriadas         Tarefa[]          @relation("TarefaCriadoPor")

  @@unique([storeId, email])
  @@unique([storeId, usuario])
  @@map("users")
}

model Shortage {
  id              String         @id @default(uuid())
  storeId         String         @map("store_id")
  store           Store          @relation(fields: [storeId], references: [id])
  codigoPeca      String?        @map("codigo_peca")
  nomePeca        String         @map("nome_peca")
  qtdRestante     Int            @map("qtd_restante")
  observacao      String?
  registradoPorId String         @map("registrado_por_id")
  registradoPor   User           @relation("RegistradoPor", fields: [registradoPorId], references: [id])
  distribuidoraId String?        @map("distribuidora_id")
  distribuidora   Distribuidora? @relation(fields: [distribuidoraId], references: [id])
  origem          ShortageOrigin @default(WEB)
  status          ShortageStatus @default(REGISTRADA)
  criadaEm        DateTime       @default(now()) @map("criada_em")
  atualizadaEm    DateTime       @updatedAt @map("atualizada_em")

  transicoes StatusTransition[]
  emprestimo Emprestimo?

  @@index([storeId, status])
  @@map("shortages")
}

model Distribuidora {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  store        Store    @relation(fields: [storeId], references: [id])
  nome         String
  ativa        Boolean  @default(true)
  criadaEm     DateTime @default(now()) @map("criada_em")
  atualizadaEm DateTime @updatedAt @map("atualizada_em")

  shortages Shortage[]

  @@unique([storeId, nome])
  @@map("distribuidoras")
}

// Peca emprestada de loja parceira enquanto o pedido de reposicao nao chega.
// Nasce junto com a falta (checkbox no registro) e sai da lista ativa ao ser
// devolvida, guardando quem marcou, a quem foi devolvida e quando.
model Emprestimo {
  id              String           @id @default(uuid())
  storeId         String           @map("store_id")
  store           Store            @relation(fields: [storeId], references: [id])
  shortageId      String           @unique @map("shortage_id")
  shortage        Shortage         @relation(fields: [shortageId], references: [id])
  emprestadaDe    String?          @map("emprestada_de")
  status          EmprestimoStatus @default(PENDENTE)
  registradoPorId String           @map("registrado_por_id")
  registradoPor   User             @relation("EmprestimoRegistradoPor", fields: [registradoPorId], references: [id])
  devolvidoPorId  String?          @map("devolvido_por_id")
  devolvidoPor    User?            @relation("EmprestimoDevolvidoPor", fields: [devolvidoPorId], references: [id])
  devolvidoPara   String?          @map("devolvido_para")
  devolvidoEm     DateTime?        @map("devolvido_em")
  criadoEm        DateTime         @default(now()) @map("criado_em")
  atualizadoEm    DateTime         @updatedAt @map("atualizado_em")

  @@index([storeId, status])
  @@map("emprestimos")
}

// Quadro de tarefas do GERENTE/ADMIN (kanban com sprints opcionais).
model Sprint {
  id           String    @id @default(uuid())
  storeId      String    @map("store_id")
  store        Store     @relation(fields: [storeId], references: [id])
  nome         String
  inicio       DateTime?
  fim          DateTime?
  encerrada    Boolean   @default(false)
  criadoPorId  String    @map("criado_por_id")
  criadoPor    User      @relation("SprintCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  tarefas Tarefa[]

  @@map("sprints")
}

model Tarefa {
  id           String       @id @default(uuid())
  storeId      String       @map("store_id")
  store        Store        @relation(fields: [storeId], references: [id])
  sprintId     String?      @map("sprint_id")
  sprint       Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  titulo       String
  descricao    String?
  status       TarefaStatus @default(A_FAZER)
  prazo        DateTime?
  criadoPorId  String       @map("criado_por_id")
  criadoPor    User         @relation("TarefaCriadoPor", fields: [criadoPorId], references: [id])
  concluidaEm  DateTime?    @map("concluida_em")
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  @@index([storeId, sprintId])
  @@map("tarefas")
}

model StatusTransition {
  id              String          @id @default(uuid())
  shortageId      String          @map("shortage_id")
  shortage        Shortage        @relation(fields: [shortageId], references: [id])
  de              ShortageStatus?
  para            ShortageStatus
  executadaPorId  String          @map("executada_por_id")
  executadaPor    User            @relation("ExecutadaPor", fields: [executadaPorId], references: [id])
  motivo          String?
  ocorridaEm      DateTime        @default(now()) @map("ocorrida_em")

  @@map("status_transitions")
}
