# Postgres (usado pelo docker-compose.yml)
POSTGRES_USER=meucopiloto
POSTGRES_PASSWORD=meucopiloto
POSTGRES_DB=meucopiloto

# Backend
DATABASE_URL="postgresql://meucopiloto:meucopiloto@localhost:5432/meucopiloto?schema=public"
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
# Deve ser igual ao id da loja criada pelo seed (ver prisma/seed.ts)
DEFAULT_STORE_ID="loja-piloto"

# Seed (loja piloto + admin inicial)
SEED_STORE_NAME="Loja Piloto"
SEED_ADMIN_NOME="Administrador"
SEED_ADMIN_EMAIL="admin@lojapiloto.com"
SEED_ADMIN_SENHA="TrocarSenha123!"
